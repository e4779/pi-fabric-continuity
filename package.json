{
  "name": "pi-fabric-continuity",
  "version": "0.4.0",
  "description": "Continual harness for pi on fabric primitives: provider-owned journal of self-improving notes/principles, exposed as the `continuity` FabricProvider and callable from fabric_exec.",
  "type": "module",
  "main": "./src/index.ts",
  "license": "ISC",
  "image": "https://raw.githubusercontent.com/e4779/pi-fabric-continuity/main/media/banner.svg",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["pi-extension", "pi-package", "pi-fabric", "continual-harness", "self-improvement", "memory", "compaction"],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "author": "e4779",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e4779/pi-fabric-continuity.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.build.json && cd tests && for p in journal audit certify inject completions delivery refine counters vcc search; do node $p.probe.mjs || exit 1; done"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "pi-fabric": ">=0.117.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "pi-fabric": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "pi-fabric": "npm:@e4779/pi-fabric@^0.117.2-fork.28",
    "typescript": "^6.0.3"
  }
}
